{
  "id": "lofi",
  "version": 1,
  "name": "Lofi",
  "genre": {
    "tempoHint": [70, 90],
    "doubleTimeHint": false,
    "subDominance": 0.15,
    "onsetDensity": 0.25,
    "continuousRegimePreference": true
  },
  "style": "spectrum-pro",
  "mapping": {
    "impact": { "from": ["KICK"], "gain": 0.45, "decay": 0.35 },
    "accent": { "from": ["SNARE", "CLAP"], "gain": 0.45, "decay": 0.40 },
    "tick": { "from": ["HAT", "PERC"], "gain": 0.30, "decay": 0.15 },
    "subImpact": { "from": ["SUB_HIT"], "gain": 0.6, "decay": 0.90 },
    "drive": { "from": "feature:energy", "rise": 0.30, "fall": 1.20 },
    "weight": { "from": "feature:band.sub", "rise": 0.20, "fall": 0.80 },
    "brightness": { "from": "feature:centroid", "rise": 0.50, "fall": 1.00 }
  },
  "palette": {
    "bg": ["#120E0A", "#1A140D"],
    "primary": "#C9A876",
    "secondary": "#5A4A32",
    "accent": "#8FBFA8",
    "glow": "#D8C29A",
    "contrast": 0.35,
    "drift": { "lowEnergy": "#5A4A32", "highEnergy": "#8FBFA8" }
  },
  "macros": {
    "energy": 0.35,
    "reactivity": 0.20,
    "density": 0.40,
    "movement": 0.30,
    "depth": 0.40,
    "glow": 0.30,
    "chaos": 0.15,
    "smoothness": 0.90
  },
  "safety": { "reducedFlashing": false }
}
